// Defines the User model that Prisma maps to database records.
model User {
  // Marks id as the unique identifier for each record.
  id           Int       @id @default(autoincrement())
  // Declares the name field and its Prisma type (String).
  name         String
  // Prevents duplicate email values in the database.
  email        String    @unique
  // Declares the passwordHash field and its Prisma type (String).
  passwordHash String    @map("password_hash")
  // Supplies a default value for role when a record is created.
  role         Role      @default(PM)
  // Declares the phone field and its Prisma type (String?).
  phone        String?
  // Supplies a default value for isActive when a record is created.
  isActive     Boolean   @default(true) @map("is_active")
  // Declares the lastLoginAt field and its Prisma type (DateTime?).
  lastLoginAt  DateTime? @map("last_login_at")
  // Supplies a default value for createdAt when a record is created.
  createdAt    DateTime  @default(now()) @map("created_at")
  // Updates updatedAt automatically whenever this record changes.
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Connects projectsManaged to its related model so Prisma can traverse the relationship.
  projectsManaged     Project[]          @relation("ProjectPM")
  // Connects projectsCreated to its related model so Prisma can traverse the relationship.
  projectsCreated     Project[]          @relation("ProjectCreatedBy")
  // Declares the landsCreated field and its Prisma type (Land[]).
  landsCreated        Land[]
  // Declares the dailyLogsCreated field and its Prisma type (DailyLog[]).
  dailyLogsCreated    DailyLog[]
  // Connects stockTxnsCreated to its related model so Prisma can traverse the relationship.
  stockTxnsCreated    StockTransaction[] @relation("StockTxnCreatedBy")
  // Connects stockTxnsVoided to its related model so Prisma can traverse the relationship.
  stockTxnsVoided     StockTransaction[] @relation("StockTxnVoidedBy")
  // Connects billsSubmitted to its related model so Prisma can traverse the relationship.
  billsSubmitted      Bill[]             @relation("BillSubmittedBy")
  // Connects billsApproved to its related model so Prisma can traverse the relationship.
  billsApproved       Bill[]             @relation("BillApprovedBy")
  // Declares the paymentsRecorded field and its Prisma type (Payment[]).
  paymentsRecorded    Payment[]
  // Declares the auditLogs field and its Prisma type (AuditLog[]).
  auditLogs           AuditLog[]
  // Declares the notifications field and its Prisma type (Notification[]).
  notifications       Notification[]
  // Declares the attachmentsUploaded field and its Prisma type (Attachment[]).
  attachmentsUploaded Attachment[]

  // Adds a model-level database rule or mapping for Prisma.
  @@map("users")
// Closes the current Prisma model, enum, or configuration block.
}

// Defines the Land model that Prisma maps to database records.
