  notes        String?
  // Declares the createdById field and its Prisma type (Int).
  createdById  Int       @map("created_by_id")
  // Supplies a default value for createdAt when a record is created.
  createdAt    DateTime  @default(now()) @map("created_at")
  // Updates updatedAt automatically whenever this record changes.
