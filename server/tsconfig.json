// Groups related TypeScript compiler settings.
{
  // Sets the compilerOptions TypeScript compiler option for this project.
  "compilerOptions": {
    // Sets the target TypeScript compiler option for this project.
    "target": "ES2022",
    // Sets the module TypeScript compiler option for this project.
    "module": "NodeNext",
    // Sets the moduleResolution TypeScript compiler option for this project.
    "moduleResolution": "NodeNext",
    // Sets the outDir TypeScript compiler option for this project.
    "outDir": "dist",
    // Sets the rootDir TypeScript compiler option for this project.
    "rootDir": "src",
    // Sets the strict TypeScript compiler option for this project.
    "strict": true,
    // Sets the esModuleInterop TypeScript compiler option for this project.
    "esModuleInterop": true,
    // Sets the forceConsistentCasingInFileNames TypeScript compiler option for this project.
    "forceConsistentCasingInFileNames": true,
    // Sets the skipLibCheck TypeScript compiler option for this project.
    "skipLibCheck": true,
    // Sets the types TypeScript compiler option for this project.
    "types": ["node"]
  // Groups related TypeScript compiler settings.
  },
  // Sets the include TypeScript compiler option for this project.
  "include": ["src/**/*.ts"]
// Groups related TypeScript compiler settings.
}
