# Provides the NODE_ENV example setting without including a real secret.
NODE_ENV=development
# Provides the PORT example setting without including a real secret.
PORT=4000
# Provides the DATABASE_URL example setting without including a real secret.
DATABASE_URL=postgresql://forgeos_user:forgeos_dev_password@localhost:5432/forgeos_db?schema=public
# Provides the CORS_ORIGIN example setting without including a real secret.
CORS_ORIGIN=http://localhost:5180
# Provides the LOG_LEVEL example setting without including a real secret.
LOG_LEVEL=info
# Provides the JWT_SECRET example setting without including a real secret.
JWT_SECRET=replace_with_at_least_32_random_characters
# Provides the JWT_EXPIRES_IN example setting without including a real secret.
JWT_EXPIRES_IN=15m
