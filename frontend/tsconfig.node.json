// Groups related TypeScript compiler settings.
{
  // Sets the compilerOptions TypeScript compiler option for this project.
  "compilerOptions": {
    // Sets the tsBuildInfoFile TypeScript compiler option for this project.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // Sets the target TypeScript compiler option for this project.
    "target": "es2023",
    // Sets the lib TypeScript compiler option for this project.
    "lib": ["ES2023"],
    // Sets the types TypeScript compiler option for this project.
    "types": ["node"],
    // Sets the skipLibCheck TypeScript compiler option for this project.
    "skipLibCheck": true,

    // Groups related TypeScript compiler settings.
    /* Bundler mode */
    // Sets the module TypeScript compiler option for this project.
    "module": "nodenext",
    // Sets the allowImportingTsExtensions TypeScript compiler option for this project.
    "allowImportingTsExtensions": true,
    // Sets the verbatimModuleSyntax TypeScript compiler option for this project.
    "verbatimModuleSyntax": true,
    // Sets the moduleDetection TypeScript compiler option for this project.
    "moduleDetection": "force",
    // Sets the noEmit TypeScript compiler option for this project.
    "noEmit": true,

    // Groups related TypeScript compiler settings.
    /* Linting */
    // Sets the noUnusedLocals TypeScript compiler option for this project.
    "noUnusedLocals": true,
    // Sets the noUnusedParameters TypeScript compiler option for this project.
    "noUnusedParameters": true,
    // Sets the erasableSyntaxOnly TypeScript compiler option for this project.
    "erasableSyntaxOnly": true,
    // Sets the noFallthroughCasesInSwitch TypeScript compiler option for this project.
    "noFallthroughCasesInSwitch": true
  // Groups related TypeScript compiler settings.
  },
  // Sets the include TypeScript compiler option for this project.
  "include": ["vite.config.ts"]
// Groups related TypeScript compiler settings.
}
