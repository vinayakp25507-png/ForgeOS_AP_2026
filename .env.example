# ForgeOS — environment template.
# Copy to .env and fill in real values:   cp .env.example .env

# PostgreSQL connection string.
# Local dev (Supabase free tier or any Postgres 14+):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Render: the DATABASE_URL env var is set automatically for managed Postgres,
# or set it explicitly for an external DB. Prisma uses `postgresql` provider.
# Create the schema and demo data with:   bun run db:push && bun run db:seed
DATABASE_URL=postgresql://user:password@localhost:5432/forgeos

# Session-signing secret — REQUIRED, at least 32 characters.
# Generate one with:   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars-long

# ---------------------------------------------------------------------------
# Optional integrations — login falls back to dev behaviour while unset.
# ---------------------------------------------------------------------------

# OTP email delivery via Gmail with an App Password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA on the
# Google account), then set SMTP_USER to the Gmail address and SMTP_PASS to the
# 16-char app password. While unset, OTP login shows the code in the API
# response (dev mode).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
